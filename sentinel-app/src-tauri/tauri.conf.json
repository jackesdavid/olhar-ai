{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Olhar AI",
  "version": "0.1.0",
  "identifier": "com.olharai.tauri",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "VITE_CONTROL_URL=https://control.olharai.com VITE_GATEWAY_URL=https://gateway.olharai.com npm run dev",
    "beforeBuildCommand": "VITE_CONTROL_URL=https://control.olharai.com VITE_GATEWAY_URL=https://gateway.olharai.com npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Olhar AI",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "3A4H2Y6ZVM"
    }
  }
}