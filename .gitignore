target/
node_modules/

# Python AI sidecar (ai/sidecar) — local venv, caches, downloaded model weights
.venv/
__pycache__/
*.pt

# macOS
.DS_Store

# Local secrets — never commit these
.env
.vscode/launch.json

# Runtime state — the ratatui app (legacy/) writes these to its cwd; the web app
# (app/) writes its own under the OS app-data dir. Never commit either.
devices.json
config.json
notifications.json
map.json
mapview.json
alerts.json
workflows.json

/bin/

.env*.claude/worktrees/
.env.bak.*
.env.bak

# The edge's local camera cache — the ONE place RTSP credentials live (CLAUDE.md).
# It is written wherever the edge runs, including a dev checkout. Never track it.
cameras-cache.json

deploy/macos-pkg/build/

# Windows installer build artifacts (payload + downloaded binaries + the zip).
deploy/windows/build/

# Edge cross-build outputs (per-platform binaries + container build dirs — regenerable).
sentinel-edge/dist/
deploy/edge-coral/out/
out/
dist/

# Scratch git worktrees created by the agent tooling — never source.
.claude/worktrees/
deploy/olharai/sentinel.env
experiments/gst-spike/target/
experiments/gst-spike/Cargo.lock
.fingerprint.email-preview/

# Tauri iOS: generated Xcode project + build output. `tauri ios init` regenerates it, and the
# xcarchive is hundreds of MB — the shell's source of truth is src-tauri/{Cargo.toml,tauri.conf.json,src}.
sentinel-app/src-tauri/gen/
sentinel-app/src-tauri/target/

# The graph engine is its OWN repository (github.com/jackesdavid/graph-engine), checked out here
# only so both trees are open side by side. It is consumed by TAG, never by path — see
# crates/app-core/Cargo.toml. Ignored so its files can never be committed into this repo, which
# would quietly undo the extraction.
/graph-engine/

# The local-engine override (see .cargo/config.toml.local-engine). Ignored because with it in
# place, this repo and CI compile different code — that is a deliberate, temporary state, not
# something to share.
/.cargo/config.toml
