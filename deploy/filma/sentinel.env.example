# Filma AI stack secrets — copy to `sentinel.env` ON THE SERVER and fill in. NEVER commit sentinel.env.
# Referenced by docker-compose.filma.yml (env_file). Greenfield: generate fresh values.

# Auth — a fresh secret (greenfield; no old sessions/tokens to preserve).
JWT_SECRET=

# Platform master (seeded into the empty DB on first control boot).
MASTER_EMAIL=
MASTER_PASSWORD=

# Google OAuth (redirect URIs registered in Google Cloud console → control.filma.com/...).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Assistant chat (shared control+flow) and TTS/STT.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=

# Billing (#63). Stripe serves BRL+USD.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Asaas alternative (Brazil-only), if PAYMENT_PROVIDER=asaas:
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=

# Object store (local MinIO). Any strong values; MinIO is created with them on first up.
S3_KEY=sentinel
S3_SECRET=

# Telegram global send token fallback (per-tenant config overrides this).
# TELEGRAM_BOT_TOKEN=
