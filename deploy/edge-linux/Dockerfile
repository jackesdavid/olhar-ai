# Build the sentinel-edge appliance binary for Linux (amd64).
#
# The edge is **pure Rust** — no OpenCV, no native anything (card #79). This image used to exist
# because the binary was soname-coupled to its build host's OpenCV; now it exists only to pin the
# **glibc** it links against, so we build on the same Fedora major the appliance (Bazzite) tracks.
# A static musl build would remove even that, and collapse the two Linux assets into one.
#
# Build context is the REPO ROOT (the edge links ../crates/app-core by path):
#   docker build -f deploy/edge-linux/Dockerfile --platform linux/amd64 \
#     -t sentinel-edge-linux-build .
# Then extract the binary:
#   id=$(docker create sentinel-edge-linux-build); \
#   docker cp "$id":/out/sentinel-edge ./sentinel-edge-linux-x86_64; docker rm "$id"
#
# Bump ARG FEDORA to whatever Fedora major the target Bazzite tracks.
ARG FEDORA=42
FROM fedora:${FEDORA} AS build

# Rust toolchain + GStreamer dev libs. The edge is `gst-linked` now (card #138): GStreamer is the
# their -devel + pkg-config at compile time. The RUNTIME libs + plugins are installed on the target
# by install.sh (gstreamer1-plugins-{base,good,bad,ugly,libav}); this image only needs the -devel.
RUN dnf install -y --setopt=install_weak_deps=False \
      rust cargo gcc pkgconf-pkg-config \
      gstreamer1-devel gstreamer1-plugins-base-devel \
 && dnf clean all

WORKDIR /src
# Only the paths the edge build touches (keeps the context small + cache-friendly).
COPY sentinel-edge/ sentinel-edge/
COPY crates/ crates/

WORKDIR /src/sentinel-edge
# NOT --locked: the committed Cargo.lock is generated by the macOS toolchain and Fedora's
# newer cargo wants to refresh the index; let it resolve so the Linux build isn't blocked.
# `--features gst-linked`: the sole media path (matches release.yml + the macOS bundle).
RUN cargo build --release --features gst-linked

# Stage just the artifact so `docker cp` from a throwaway container is a one-liner.
FROM scratch AS artifact
COPY --from=build /src/sentinel-edge/target/release/sentinel-edge /out/sentinel-edge

# ---------------------------------------------------------------------------
# Self-contained runtime image — appliance packaging for an IMMUTABLE host (Bazzite / Silverblue),
# edge just runs.
#
# Its original reason is gone: it existed to guarantee a matching OpenCV soname on a host where you
# too — this image is now a convenience, not a requirement.
#
# Build: docker build -f deploy/edge-linux/Dockerfile --target runtime -t sentinel-edge .
# Run recipe: see deploy/edge-linux/entrypoint.sh.
FROM fedora:${FEDORA} AS runtime
# The GStreamer RUNTIME (the build stage installs only -devel): rtspsrc + rtph264depay come from
# plugins-good, h264parse from plugins-bad, mp4mux from the isomp4 set. Without these the binary
# links fine and then finds no elements at run time — a failure that looks like a broken camera.
RUN dnf install -y --setopt=install_weak_deps=False \
      iproute procps-ng ca-certificates \
      gstreamer1 gstreamer1-plugins-base gstreamer1-plugins-good gstreamer1-plugins-bad-free \
 && dnf clean all
COPY --from=build /src/sentinel-edge/target/release/sentinel-edge /usr/local/bin/sentinel-edge
COPY deploy/edge-linux/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV EDGE_BIND=0.0.0.0:8788 \
    EDGE_CACHE=/opt/sentinel-edge/cameras-cache.json \
    PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
RUN mkdir -p /opt/sentinel-edge/recordings
ENTRYPOINT ["/entrypoint.sh"]
