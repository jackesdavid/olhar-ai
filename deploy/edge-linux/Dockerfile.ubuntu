# Build the sentinel-edge appliance binary for Debian/Ubuntu (glibc/apt) — amd64.
#
# Companion to ./Dockerfile (Fedora). The edge links OpenCV DYNAMICALLY, so the run host's
# OpenCV soname must match the build's. Ubuntu 24.04 (noble) + Debian 12 (bookworm) both ship
# OpenCV 4.6 (libopencv_video.so.406), which is what `install.sh`'s apt path installs
# (`apt install libopencv-dev`). Ubuntu 22.04 ships 4.5 (.405) — build with UBUNTU=22.04 for it.
#
# Build context is the REPO ROOT:
#   docker build -f deploy/edge-linux/Dockerfile.ubuntu --platform linux/amd64 \
#     --target artifact -o type=local,dest=out .
# Artifact lands at out/out/sentinel-edge → publish as sentinel-edge-linux-x86_64-gnu.
ARG UBUNTU=24.04
FROM ubuntu:${UBUNTU} AS build

# Toolchain + OpenCV headers/libs + libclang (opencv-rust generates bindings via clang).
# Ubuntu's apt `cargo` can lag, so Rust comes from rustup.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates pkg-config \
      build-essential clang libclang-dev llvm-dev \
      libopencv-dev \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH

WORKDIR /src
COPY sentinel-edge/ sentinel-edge/
COPY crates/ crates/

WORKDIR /src/sentinel-edge
# Point clang-sys at libclang explicitly (its dir is llvm-version-specific on Ubuntu).
RUN LIBCLANG_PATH="$(dirname "$(find /usr/lib -name 'libclang.so*' | head -1)")" \
    cargo build --release

FROM scratch AS artifact
COPY --from=build /src/sentinel-edge/target/release/sentinel-edge /out/sentinel-edge
