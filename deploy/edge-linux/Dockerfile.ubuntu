# Build the sentinel-edge appliance binary for Debian/Ubuntu (glibc/apt) — amd64.
#
# Companion to ./Dockerfile (Fedora). The edge is pure Rust (card #79) — this second image is not
# about OpenCV any more, it is about **glibc**: a binary built against Fedora's glibc won't start on
# an older Debian/Ubuntu. Building here pins the floor to Ubuntu 24.04 (noble) / Debian 12
# (bookworm); use UBUNTU=22.04 for an older floor.
#
# (A static musl build would make this file — and the two-asset split — unnecessary.)
#
# Build context is the REPO ROOT:
#   docker build -f deploy/edge-linux/Dockerfile.ubuntu --platform linux/amd64 \
#     --target artifact -o type=local,dest=out .
# Artifact lands at out/out/sentinel-edge → publish as sentinel-edge-linux-x86_64-gnu.
ARG UBUNTU=24.04
FROM ubuntu:${UBUNTU} AS build

# Just a Rust toolchain (apt's `cargo` can lag, so Rust comes from rustup). This used to also pull
# clang, libclang-dev, llvm-dev and libopencv-dev for opencv-rust's binding generator.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates pkg-config build-essential \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH

WORKDIR /src
COPY sentinel-edge/ sentinel-edge/
COPY crates/ crates/

WORKDIR /src/sentinel-edge
# Point clang-sys at libclang explicitly (its dir is llvm-version-specific on Ubuntu).
RUN LIBCLANG_PATH="$(dirname "$(find /usr/lib -name 'libclang.so*' | head -1)")" \
    cargo build --release

FROM scratch AS artifact
COPY --from=build /src/sentinel-edge/target/release/sentinel-edge /out/sentinel-edge
