# Keep the build context small: exclude all build outputs, deps, and VCS.
**/target
**/node_modules
.git
sentinel-app/build
sentinel-app/.svelte-kit
sentinel-app/dist
**/cameras-cache.json
docs
legacy
.devtool
ai
# Build artefacts of the DESKTOP installers and the GStreamer spikes — 1.1GB of context that no
# service image ever reads. Sending them crashed the daemon mid-transfer (rpc EOF at 1.39GB).
deploy/macos-pkg/build
deploy/windows/build
experiments

# The mobile app: 3.5GB including iOS build products (Xcode DerivedData, .framework bundles).
# No service image reads any of it, and a local build died writing ExpoModulesCore.framework
# into a Rust image's context with "no space left on device".
sentinel-mobile
sentinel-edge/dist
# Coral/Edge-TPU build OUTPUT in a tracked directory: 1.7GB that every service image paid to
# transfer and none of them read a byte of.
deploy/edge-coral/out
