# Bishop secrets — TEMPLATE. Copy to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored (this template is committed so the required keys are documented).
# Loaded by `task` (Taskfile dotenv) for the web app, and by VS Code's launch.json
# (envFile) for the ratatui debugger — one source of truth for both.

# --- Database (Postgres + pgvector — devices store) ---
# Start the DB with `task db-up` (see compose.yaml). Required: the app waits on
# the splash until this is reachable and migrations have applied.
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel

# --- Workflow engine service (sentinel-flow) ---
# The Tauri app is a CLIENT of the always-on `sentinel-flow` service (run it with
# `task flow`) — it has no embedded engine. Workflow runs + run-state proxy to the
# service and its live events are bridged back to the UI. Override the address here;
# defaults to http://127.0.0.1:8787 when unset.
# FLOW_URL=http://127.0.0.1:8787

# --- Event fabric (Redis pub/sub) ---
# Enables workflow node animations and edge-motion event injection. Start Redis with
# `task db-up` (it's already in compose.yaml). Without this, sentinel-control falls
# back to proxying sentinel-flow's /events directly (single-pod, no edge motion).
# REDIS_URL=redis://127.0.0.1:6379

# --- Control plane (sentinel-control) — central source of truth ---
# Serves the camera list to edge appliances (so they carry no Postgres). Backed by
# DATABASE_URL above. Run with `task control`.
# CONTROL_BIND=127.0.0.1:8790

# --- Edge appliance (sentinel-edge) — the ONLY thing that talks to local cameras ---
# Owns go2rtc (RTSP → MSE/snapshots, bound to 127.0.0.1:1984). Config-light: it has
# NO database — it pulls its camera list from the control plane and caches it locally.
# CONTROL_URL=http://127.0.0.1:8790                   # where the edge pulls cameras from
# EDGE_BIND=127.0.0.1:8788                            # the edge service's own listen addr
# EDGE_OWN_GO2RTC=1                                   # 0 to reuse an existing :1984 (dev w/ desktop app)
# GO2RTC_BIN=app/src-tauri/binaries/go2rtc           # path to the go2rtc binary it spawns
# EDGE_CACHE=cameras-cache.json                       # offline fallback for the camera list

# --- Public streaming bridge (sentinel-gateway) ---
# ALL camera media (the desktop app + browsers) flows through the gateway — the same
# path locally and in production. The gateway reaches the edge's go2rtc over Tailscale.
GATEWAY_URL=http://127.0.0.1:8789                     # desktop app → gateway (live + snapshots)
# GATEWAY_BIND=127.0.0.1:8789                         # the gateway service's own listen addr
# The gateway → edge upstream. Point this at the edge's MagicDNS host so it rides the
# tailnet even locally; falls back to loopback go2rtc when Tailscale isn't set up.
EDGE_UPSTREAM=http://127.0.0.1:1984                   # or: https://tenant-001.<your-tailnet>.ts.net

# --- Tailscale (private edge↔gateway VPN) ---
# Opt-in: when TS_AUTHKEY is set, the edge runs `tailscale up` + `tailscale serve 1984`
# and the gateway runs `tailscale up`. Needs tailscaled installed + MagicDNS & HTTPS
# certs enabled on the tailnet. Per-edge hostname/tag pre-stage the per-tenant identity.
# TS_AUTHKEY=tskey-auth-xxxxxxistration
# TS_HOSTNAME=tenant-001
# TS_TAGS=tag:tenant-001

# --- Anthropic (Bishop chat + vision) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8   # optional override

# --- ElevenLabs (voice / TTS — M3 unit 021) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Person detection runs on-device (YOLOX-Nano via ONNX Runtime) — no sidecar, no keys.

# --- Telegram (beacons / notifications) ---
# In the web app you can also set these in-app (Beacons screen → telegram.json),
# which takes precedence over these env values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PAIRING_CODE=

# --- Billing: AI/GPU metering rate (#63) ---
# Price per GPU-second attributed to a tenant for RunPod AI-sidecar calls. Default 0 →
# usage (delay+exec ms) is still recorded, cost stays 0 until a rate is set. Depends on
# the endpoint's GPU (e.g. RTX 2060 vs H100). Currency-agnostic (treated as USD).
AI_RATE_PER_SEC=0

# --- Billing: payment gateway (#63) ---
# Provider seam: 'asaas' (Brazil — Pix/boleto/cartão) now; 'stripe' (international) later.
PAYMENT_PROVIDER=asaas
# Asaas REST base — the SANDBOX url for testing, prod (default) for real charges.
# ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_BASE_URL=https://api.asaas.com/v3
# Secret — your Asaas account API key (access_token).
ASAAS_API_KEY=
# Secret — the token you set on the Asaas webhook; inbound webhooks must present it in the
# `asaas-access-token` header. Point the Asaas webhook at <control-url>/webhooks/asaas.
ASAAS_WEBHOOK_TOKEN=
