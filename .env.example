# Bishop secrets — TEMPLATE. Copy to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored (this template is committed so the required keys are documented).
# Loaded by `task` (Taskfile dotenv) for the web app, and by VS Code's launch.json
# (envFile) for the ratatui debugger — one source of truth for both.

# --- Anthropic (Bishop chat + vision) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8   # optional override

# --- ElevenLabs (voice / TTS — M3 unit 021) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- AI sidecar (vision: person detection, face embedding — services/ai) ---
# RunPod Serverless runsync URL, or http://localhost:8000/runsync for local dev
# (`python services/ai/handler.py --rp_serve_api`). See services/ai/README.md.
AI_SERVICE_URL=
AI_SERVICE_KEY=

# --- Telegram (beacons / notifications) ---
# In the web app you can also set these in-app (Beacons screen → telegram.json),
# which takes precedence over these env values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PAIRING_CODE=
