# Bishop secrets — TEMPLATE. Copy to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored (this template is committed so the required keys are documented).
# Loaded by `task` (Taskfile dotenv) for the web app, and by VS Code's launch.json
# (envFile) for the ratatui debugger — one source of truth for both.

# --- Database (Postgres + pgvector — devices store) ---
# Start the DB with `task db-up` (see compose.yaml). Required: the app waits on
# the splash until this is reachable and migrations have applied.
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel

# --- Workflow engine service (sentinel-flow) ---
# The Tauri app is a CLIENT of the always-on `sentinel-flow` service (run it with
# `task flow`) — it has no embedded engine. Workflow runs + run-state proxy to the
# service and its live events are bridged back to the UI. Override the address here;
# defaults to http://127.0.0.1:8787 when unset.
# FLOW_URL=http://127.0.0.1:8787

# --- Edge gateway (sentinel-edge) — the ONLY thing that talks to local cameras ---
# Owns go2rtc (RTSP → MSE/snapshots, bound to 127.0.0.1:1984) + serves snapshots.
# The desktop app has NO embedded go2rtc — it's a CLIENT of the edge for live
# streams + snapshots (EDGE_URL). Run the edge with `task edge`.
EDGE_URL=http://127.0.0.1:8788
# EDGE_BIND=127.0.0.1:8788                            # the edge service's own listen addr
# EDGE_OWN_GO2RTC=1                                   # 0 to reuse an existing :1984 (dev w/ desktop app)
# GO2RTC_BIN=app/src-tauri/binaries/go2rtc           # path to the go2rtc binary it spawns

# --- Public streaming bridge (sentinel-gateway) ---
# Browsers connect here; it proxies MSE (WS) + snapshots to a client's edge box.
# GATEWAY_BIND=127.0.0.1:8789
# EDGE_UPSTREAM=http://127.0.0.1:1984                 # dev (one box); prod: https://<host>.<tailnet>.ts.net

# --- Tailscale (private edge↔gateway VPN) ---
# Opt-in: when TS_AUTHKEY is set, the edge runs `tailscale up` + `tailscale serve 1984`
# and the gateway runs `tailscale up`. Needs tailscaled installed + MagicDNS & HTTPS
# certs enabled on the tailnet. Per-edge hostname/tag pre-stage the per-tenant identity.
# TS_AUTHKEY=tskey-auth-xxxxxxistration
# TS_HOSTNAME=tenant-001
# TS_TAGS=tag:tenant-001

# --- Anthropic (Bishop chat + vision) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8   # optional override

# --- ElevenLabs (voice / TTS — M3 unit 021) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Person detection runs on-device (YOLOX-Nano via ONNX Runtime) — no sidecar, no keys.

# --- Telegram (beacons / notifications) ---
# In the web app you can also set these in-app (Beacons screen → telegram.json),
# which takes precedence over these env values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PAIRING_CODE=
