# Expo pins `react` to the exact version the SDK ships (19.2.3), but transitive web deps pulled in
# by expo-router's server bits ask for a newer react-dom, whose peer range then excludes it. npm 7+
# treats that as fatal. The SDK pin is the one that matters for a native app, so let npm resolve
# rather than refuse. Removing this line makes `npm install` fail outright.
legacy-peer-deps=true
