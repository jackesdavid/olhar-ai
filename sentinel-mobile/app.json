{
  "expo": {
    "name": "Olhar AI",
    "slug": "olhar-ai",
    "owner": "olhar-ai",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "olharai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.olharai.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Olhar AI finds and streams your cameras over your local network.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.olharai.app"
        ]
      },
      "appleTeamId": "3A4H2Y6ZVM"
    },
    "android": {
      "package": "com.olharai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-status-bar",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Olhar AI uses the camera to scan an invite QR code and to capture faces on the capture screen."
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "3A4H2Y6ZVM"
        }
      ],
      "expo-screen-orientation"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94781a1a-dffb-4eda-8496-646ac21a168c",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.olharai.app.widget",
                  "targetName": "OlharAIWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.olharai.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "icon": "./assets/icon.png",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#FAFAFA"
    }
  }
}
