{
  "expo": {
    "name": "Olhar AI",
    "slug": "olharai",
    "owner": "olharai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "olharai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.olharai.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Olhar AI connects to the development server and to cameras on your local network."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.olharai.app"
        ]
      },
      "appleTeamId": "3A4H2Y6ZVM"
    },
    "android": {
      "package": "com.olharai.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-status-bar",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Olhar AI uses the camera to capture faces while you are on the capture screen."
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "3A4H2Y6ZVM"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4388df5f-6d84-459e-81c8-a6fe62fd3e8b"
      }
    },
    "icon": "./assets/icon.png",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#FAFAFA"
    }
  }
}
